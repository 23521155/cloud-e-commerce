APP_NAME=catalog-service

PORT=8083

# Local container: add &trustServerCertificate=true. Azure SQL: encrypt=true only.
DATABASE_URL=sqlserver://sa:<password>@localhost:1433?database=catalog&encrypt=true&trustServerCertificate=true

GRPC_PORT=9083

# Secret other services send as x-internal-token on gRPC calls (the order service).
# Leave empty to not start the gRPC server. Use a long random value outside local runs.
INTERNAL_TOKEN=
