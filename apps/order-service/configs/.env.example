APP_NAME=order-service

PORT=8084

# Local container: add &trustServerCertificate=true. Azure SQL: encrypt=true only.
DATABASE_URL=sqlserver://sa:<password>@localhost:1435?database=orders&encrypt=true&trustServerCertificate=true

# Catalogue gRPC server. Plain text locally; TLS is required on Azure App Service.
CATALOG_GRPC_ADDR=localhost:9083
CATALOG_GRPC_TLS=false

# Must equal the catalogue's INTERNAL_TOKEN. Use a long random value outside local runs.
INTERNAL_TOKEN=

# How long the books of an online order stay reserved while the customer pays (1 to 60).
PAYMENT_HOLD_MINUTES=15

# VNPay merchant account (sandbox: register at https://sandbox.vnpayment.vn/devreg).
# Leave both empty to turn online payments off.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# The web page VNPay sends the customer back to.
VNPAY_RETURN_URL=http://localhost:3000/checkout/vnpay-return
# true only where VNPay cannot reach the IPN URL (local runs without a tunnel).
VNPAY_CONFIRM_ON_RETURN=false

# Bank transfer for VietQR orders, reported by SePay (https://my.sepay.vn). Set all four, or none:
# without them VietQR orders are paid through VNPay like a card.
# The key is the one set on the SePay webhook (authentication: API Key). Use a long random value.
SEPAY_API_KEY=
SEPAY_BANK=BIDV
# BIDV personal accounts take transfers only through a virtual account (VA): use the VA here.
SEPAY_ACCOUNT_NO=
# The owner's name as the bank spells it.
SEPAY_ACCOUNT_NAME=
# How the order codes start, without the dash (MA-123456 is MA).
SEPAY_CODE_PREFIX=MA
# The webhook URL to give SePay: https://<gateway>/api/orders/payments/sepay/webhook

# Azure Storage account whose user-email-verified queue the user service writes: guest orders join
# an account once its owner confirms the email. Locally, Azurite:
# DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<Azurite key>;QueueEndpoint=http://localhost:10001/devstoreaccount1;
# Empty: guest orders are not linked.
STORAGE_CONNECTION_STRING=
