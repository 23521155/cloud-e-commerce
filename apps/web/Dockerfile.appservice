# Packages the web app as a zip for App Service (Linux, Node.js 22 code), rather than as an image.
# It builds on Debian (glibc) like App Service's Node.js image, so native packages such as sharp
# (used by next/image) match it; the Alpine build in Dockerfile uses musl and would not.
#
#   docker build -f Dockerfile.appservice --output type=local,dest=dist-appservice .
#
# writes dist-appservice/web.zip. On App Service the start command is `node server.js`.
FROM node:22-bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends zip && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# postinstall runs `prisma generate`, which needs the schema and config before `npm ci`.
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

COPY . .
RUN npm run build

# Same layout as the image in Dockerfile: output: "standalone" leaves out public/ and .next/static,
# so they are copied next to server.js before zipping.
RUN cp -r .next/static .next/standalone/.next/static \
 && cp -r public .next/standalone/public \
 && cd .next/standalone \
 && zip -qr /web.zip .

FROM scratch
COPY --from=build /web.zip /
