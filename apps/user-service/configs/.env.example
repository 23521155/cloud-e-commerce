APP_NAME=user-service

PORT=8085

# Local container: add &trustServerCertificate=true. Azure SQL: encrypt=true only.
DATABASE_URL=sqlserver://sa:<password>@localhost:1436?database=users&encrypt=true&trustServerCertificate=true

# Same secret and issuer as the API gateway, which verifies the access tokens this service signs.
# The service does not start without a secret. Use a long random value outside local runs.
JWT_SECRET=
JWT_ISSUER=

# How long an access token is accepted (Go duration).
JWT_ACCESS_TTL=15m

# How long a device stays signed in without being used (Go duration); 720h is 30 days.
JWT_REFRESH_TTL=720h

# The web app's public address, for the links in emails.
WEB_URL=http://localhost:3000

# Azure Storage account whose queues carry emails and events (the outbox). Locally, Azurite:
# DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<Azurite key>;QueueEndpoint=http://localhost:10001/devstoreaccount1;
# Empty: messages wait in the outbox table until it is set.
STORAGE_CONNECTION_STRING=
